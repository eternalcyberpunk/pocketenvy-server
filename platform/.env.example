DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=generate_at_least_32_random_bytes
LICENSE_KEY_PEPPER=generate_a_different_32_byte_secret
ZAPIER_WEBHOOK_SECRET=generate_a_third_long_random_secret
CRON_SECRET=set_by_vercel_for_cron_authorization
ADMIN_SECRET=generate_a_fourth_long_random_secret

RUNPOD_ENDPOINT_ID=replace_me
RUNPOD_API_KEY=replace_me

S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=pocketenvy-renders
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=false

ALLOWED_ORIGINS=null
SESSION_TTL=30d
MAX_UPLOAD_BYTES=21474836480
MAX_ACTIVE_JOBS=2
UPLOAD_URL_TTL_SECONDS=3600
DOWNLOAD_URL_TTL_SECONDS=3600
RUNPOD_INPUT_URL_TTL_SECONDS=21600

# 1000 units = 1 customer-facing credit.
CREDIT_UNITS_PER_MP_SECOND=8
CREDIT_UNITS_PER_GPU_MINUTE=1000
MIN_JOB_CREDIT_UNITS=250
RESERVATION_SAFETY_PERCENT=25
