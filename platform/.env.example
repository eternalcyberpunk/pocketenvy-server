# Copy to platform/.env locally; put these values in the API hosting environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=generate_a_unique_secret_at_least_32_characters
LICENSE_KEY_PEPPER=generate_a_different_secret_at_least_32_characters
ZAPIER_WEBHOOK_SECRET=generate_a_different_secret_at_least_32_characters
CRON_SECRET=generate_a_different_secret_at_least_32_characters
ADMIN_SECRET=generate_a_different_secret_at_least_32_characters

# Leave unavailable tiers blank. Customers see only the available tier names.
RUNPOD_ENDPOINT_ECONOMY=
RUNPOD_ENDPOINT_STANDARD=
RUNPOD_ENDPOINT_TURBO=
RUNPOD_API_KEY=

ENABLE_FULL_PROJECT=false
AE_FARM_BASE_URL=
AE_FARM_ECONOMY_URL=
AE_FARM_STANDARD_URL=
AE_FARM_TURBO_URL=
AE_FARM_API_KEY=

# R2: endpoint below, region auto. AWS S3: regional endpoint and AWS region.
# Private bucket only. Workers' STORAGE_HOSTS must match this hostname.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=pocketenvy-renders
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=true

ALLOWED_ORIGINS=null
SESSION_TTL=30d
MAX_UPLOAD_BYTES=4294967296
MAX_ACTIVE_JOBS=2

# 1000 units = 1 credit. Example pricing: calibrate against actual costs.
CREDIT_UNITS_PER_MP_SECOND=8
CREDIT_UNITS_PER_GPU_MINUTE=1000
MIN_JOB_CREDIT_UNITS=250
RESERVATION_SAFETY_PERCENT=25
RETENTION_CREDIT_UNITS_PER_DAY=10
FULL_PROJECT_CREDIT_MULTIPLIER=2.5
TIER_ECONOMY_MULTIPLIER=0.8
TIER_STANDARD_MULTIPLIER=1
TIER_TURBO_MULTIPLIER=1.6
