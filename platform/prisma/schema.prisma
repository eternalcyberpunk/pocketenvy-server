generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum JobStatus {
  RESERVED
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum RenderWorkflow {
  CLOUD_FINISH
  FULL_PROJECT
}

enum ComputeTier {
  ECONOMY
  STANDARD
  TURBO
}

enum RenderProvider {
  RUNPOD
  AE_FARM
}

enum CreditKind {
  PURCHASE
  ADMIN_GRANT
  JOB_RESERVATION
  JOB_SETTLEMENT
  JOB_REFUND
}

model License {
  id                 String        @id @default(cuid())
  email              String
  keyHash            String        @unique
  status             LicenseStatus @default(ACTIVE)
  maxDevices         Int           @default(2)
  creditBalanceUnits Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  devices            Device[]
  jobs               RenderJob[]
  ledger              CreditLedger[]
  uploads             Upload[]

  @@index([email])
}

model Device {
  id           String   @id @default(cuid())
  licenseId    String
  deviceHash   String
  name         String?
  active       Boolean  @default(true)
  activatedAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  license      License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, deviceHash])
  @@index([licenseId, active])
}

model RenderJob {
  id                   String    @id @default(cuid())
  licenseId            String
  clientRequestId      String
  providerJobId         String?   @unique
  provider              RenderProvider
  providerLocation      String
  workflow              RenderWorkflow
  computeTier           ComputeTier
  status               JobStatus @default(RESERVED)
  inputKey              String
  outputKey             String
  outputFilename        String
  reservedCreditUnits   Int
  settledCreditUnits    Int?
  comp                  Json
  options               Json
  pricing               Json
  receiptKey            String
  deadlineAt            DateTime
  error                 String?
  executionTimeMs       Int?
  expiresAt             DateTime?
  purgedAt              DateTime?
  inputPurgedAt         DateTime?
  settledAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  license               License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  ledger                CreditLedger[]

  @@unique([licenseId, clientRequestId])
  @@index([licenseId, status])
  @@index([status, settledAt])
  @@index([expiresAt, purgedAt])
}

model Upload {
  key           String   @id
  licenseId     String
  sizeBytes     BigInt
  contentType   String
  createdAt     DateTime @default(now())
  usedAt        DateTime?
  license       License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  @@index([licenseId, usedAt])
}

model CreditLedger {
  id           String     @id @default(cuid())
  licenseId    String
  jobId        String?
  units        Int
  kind         CreditKind
  externalRef  String?    @unique
  note         String?
  createdAt    DateTime   @default(now())
  license      License    @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  job          RenderJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([licenseId, createdAt])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  source     String
  externalId String
  payload    Json
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
}
