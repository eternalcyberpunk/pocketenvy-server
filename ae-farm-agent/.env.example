# Run npm start from this folder after copying this file to .env.
# Dedicated Windows account/VM with After Effects, matching effects and fonts.
BIND_HOST=127.0.0.1
PORT=8787
AE_FARM_API_KEY=generate_a_unique_secret_at_least_32_characters
STORAGE_HOSTS=ACCOUNT_ID.r2.cloudflarestorage.com
PYTHON_PATH=C:\Python312\python.exe
AFTERFX_PATH=C:\Program Files\Adobe\Adobe After Effects 2025\Support Files\AfterFX.com
AERENDER_PATH=C:\Program Files\Adobe\Adobe After Effects 2025\Support Files\aerender.exe
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
WORK_ROOT=C:\PocketEnvyJobs
AE_RENDER_TEMPLATE=Best Settings
AE_MASTER_TEMPLATE=Lossless
AE_PREPARE_TIMEOUT_SECONDS=300
JOB_TIMEOUT_SECONDS=21600
JOB_TIMEOUT_MS=21600000
MAX_QUEUE=10
MAX_TRANSFER_BYTES=4294967296
MAX_UNPACK_BYTES=21474836480
REQUIRE_NVENC=1
